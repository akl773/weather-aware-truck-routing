# Copy to backend/.env for local development. Every variable the API reads is listed here.

# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Without it the cache is in-process memory.
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
