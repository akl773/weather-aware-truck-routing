{
  "name": "truck-routing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "api:types": "openapi-typescript ${API_SCHEMA:-http://localhost:8000/api/schema/} -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/maplibre": "~9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@luma.gl/core": "~9.4.2",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.104.4",
    "maplibre-gl": "^6.15.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
